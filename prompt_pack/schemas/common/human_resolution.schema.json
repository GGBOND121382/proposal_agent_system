{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human_resolution.schema.json",
  "type": "object",
  "properties": {
    "resolution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "gate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "prompt_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "target_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "answer": {
      "type": ["string", "number", "integer", "boolean", "object", "array", "null"]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "decided_role": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "resolution_id",
    "gate_id",
    "prompt_id",
    "question_id",
    "question",
    "target_paths",
    "answer",
    "decided_by",
    "decided_role"
  ]
}
