{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "online_result_import_critic_model_input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approved_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_description": {
          "type": "string",
          "minLength": 1
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_inferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "task_description",
        "queries",
        "allowed_context",
        "prohibited_inferences",
        "prohibited_outputs"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "claim_id",
          "claim_text",
          "source_ids"
        ]
      }
    },
    "public_source_snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "text",
          "relevance"
        ]
      }
    }
  },
  "required": [
    "approved_task",
    "claims",
    "public_source_snippets"
  ]
}
