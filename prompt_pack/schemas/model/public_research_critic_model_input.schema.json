{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public_research_critic_model_input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "research_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "claim_id",
          "claim_text",
          "source_ids"
        ]
      }
    },
    "evidence_passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "text",
          "relevance"
        ]
      }
    },
    "declared_conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "declared_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "agreement": {
            "type": "string",
            "enum": [
              "AGREE",
              "PARTIAL",
              "CONFLICT"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "topic",
          "source_ids",
          "agreement",
          "summary"
        ]
      }
    }
  },
  "required": [
    "research_questions",
    "claims",
    "evidence_passages",
    "source_comparisons",
    "declared_conflicts",
    "declared_limitations"
  ]
}
