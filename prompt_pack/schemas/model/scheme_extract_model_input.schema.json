{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheme_extract_model_input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {"type": "string", "enum": ["RESEARCH_PROPOSAL", "ENGINEERING_PROPOSAL", "SURVEY_REPORT"]},
    "extraction_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "existing_profile": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display_name": {
              "type": ["string", "null"]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "display_name",
            "version"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "human_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer_text": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "answer_text",
          "target"
        ]
      }
    },
    "evidence_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "document_title": {
            "type": "string"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "document_title",
          "locator",
          "excerpt"
        ]
      }
    }
  },
  "required": [
    "extraction_scope",
    "existing_profile",
    "human_resolutions",
    "evidence_cards"
  ]
}
