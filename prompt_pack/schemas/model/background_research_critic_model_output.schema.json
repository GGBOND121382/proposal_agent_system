{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background_research_critic_model_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_type": {
            "type": "string",
            "enum": [
              "UNSUPPORTED_CARD",
              "OVERGENERALIZED_CARD",
              "STALE_DATA_MISREPRESENTATION",
              "MISSING_COUNTEREVIDENCE",
              "UNCOVERED_DIMENSION"
            ]
          },
          "card_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimension": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "APPLICATION_SCENARIO",
                  "STAKEHOLDER_AND_PAIN",
                  "INDUSTRY_SCALE_AND_TREND",
                  "POLICY_STANDARD_AND_PROGRAM",
                  "REPRESENTATIVE_CASE",
                  "CURRENT_ADOPTION",
                  "OPERATIONAL_CONSTRAINT",
                  "RESEARCH_SIGNIFICANCE"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "repair_instruction": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issue_type",
          "card_id",
          "dimension",
          "description",
          "evidence_source_ids",
          "repair_instruction"
        ]
      }
    },
    "missing_counterevidence_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "issues",
    "missing_counterevidence_topics"
  ]
}
