{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background_research_plan_model_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dimension_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "OBJECT_AND_EVOLUTION",
              "FUNCTION_AND_ARCHITECTURE",
              "WORKFLOW_AND_INTERACTION",
              "TECHNOLOGY_AND_IMPLEMENTATION",
              "EVALUATION_AND_EFFECT",
              "LIMITATIONS_AND_GAPS",
              "APPLICATION_SCENARIO",
              "STAKEHOLDER_AND_PAIN",
              "INDUSTRY_SCALE_AND_TREND",
              "POLICY_STANDARD_AND_PROGRAM",
              "REPRESENTATIVE_CASE",
              "CURRENT_ADOPTION",
              "OPERATIONAL_CONSTRAINT",
              "RESEARCH_SIGNIFICANCE"
            ]
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "entity_groups": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "maxItems": 8
                }
              },
              "required": [
                "query",
                "purpose"
              ]
            }
          }
        },
        "required": [
          "dimension",
          "queries"
        ]
      }
    }
  },
  "required": [
    "dimension_queries"
  ]
}
