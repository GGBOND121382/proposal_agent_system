{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background_research_critic_model_input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "required_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "APPLICATION_SCENARIO",
          "STAKEHOLDER_AND_PAIN",
          "INDUSTRY_SCALE_AND_TREND",
          "POLICY_STANDARD_AND_PROGRAM",
          "REPRESENTATIVE_CASE",
          "CURRENT_ADOPTION",
          "OPERATIONAL_CONSTRAINT",
          "RESEARCH_SIGNIFICANCE"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "background_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "enum": [
              "APPLICATION_SCENARIO",
              "STAKEHOLDER_AND_PAIN",
              "INDUSTRY_SCALE_AND_TREND",
              "POLICY_STANDARD_AND_PROGRAM",
              "REPRESENTATIVE_CASE",
              "CURRENT_ADOPTION",
              "OPERATIONAL_CONSTRAINT",
              "RESEARCH_SIGNIFICANCE"
            ]
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_mode": {
            "type": "string"
          },
          "scope_qualifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "target_section_profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "card_id",
          "claim_id",
          "dimension",
          "claim_text",
          "source_ids",
          "evidence_mode",
          "scope_qualifiers",
          "target_section_profiles",
          "conflicts",
          "limitations"
        ]
      }
    },
    "evidence_passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "enum": [
              "ACADEMIC",
              "WEB_SEARCH"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "channel",
          "text",
          "relevance"
        ]
      }
    },
    "declared_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "APPLICATION_SCENARIO",
              "STAKEHOLDER_AND_PAIN",
              "INDUSTRY_SCALE_AND_TREND",
              "POLICY_STANDARD_AND_PROGRAM",
              "REPRESENTATIVE_CASE",
              "CURRENT_ADOPTION",
              "OPERATIONAL_CONSTRAINT",
              "RESEARCH_SIGNIFICANCE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dimension",
          "reason"
        ]
      }
    },
    "retrieval_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "SUFFICIENT",
            "DEGRADED",
            "BLOCKING_FAILURE"
          ]
        },
        "web_hit_count": {
          "type": "integer",
          "minimum": 0
        },
        "academic_hit_count": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "APPLICATION_SCENARIO",
              "STAKEHOLDER_AND_PAIN",
              "INDUSTRY_SCALE_AND_TREND",
              "POLICY_STANDARD_AND_PROGRAM",
              "REPRESENTATIVE_CASE",
              "CURRENT_ADOPTION",
              "OPERATIONAL_CONSTRAINT",
              "RESEARCH_SIGNIFICANCE"
            ]
          },
          "uniqueItems": true
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "web_hit_count",
        "academic_hit_count",
        "uncovered_dimensions",
        "blocking_reasons"
      ]
    }
  },
  "required": [
    "required_dimensions",
    "background_cards",
    "evidence_passages",
    "declared_gaps",
    "retrieval_summary"
  ]
}
