{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proposal-agent.local/schemas/model/project_definition_extract_model_input.schema.json",
  "title": "P-PROJECT-DEFINITION-EXTRACT 模型输入契约",
  "description": "执行器 build_project_definition_extract_model_input 生成的模型输入；模型只做语义提取，不写 ID/Hash/版本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction_scope",
    "scheme_summary",
    "existing_project_definition",
    "human_resolutions",
    "evidence_cards"
  ],
  "properties": {
    "document_type": {"type": "string", "enum": ["RESEARCH_PROPOSAL", "ENGINEERING_PROPOSAL", "SURVEY_REPORT"]},
    "extraction_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scheme_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme_name",
        "scheme_type",
        "guide_direction_name",
        "rules"
      ],
      "properties": {
        "scheme_name": {
          "type": ["string", "null"]
        },
        "scheme_type": {
          "type": ["string", "null"]
        },
        "guide_direction_name": {
          "type": ["string", "null"]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_type", "statement", "mandatory"],
            "properties": {
              "rule_type": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "mandatory": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "existing_project_definition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["version", "project_name", "item_count", "domains"],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "project_name": {
          "type": ["string", "null"]
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer_text", "target"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer_text": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "document_title", "locator", "excerpt"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "document_title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "revision_issues": {
      "type": "array",
      "description": "系统反馈的上一轮确定性校验问题；逐项修正，保持其他有效语义不变。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problem", "severity", "component", "required_action", "evidence_ids"],
        "properties": {
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
