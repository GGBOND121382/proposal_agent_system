{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proposal-agent.local/schemas/model/project_definition_critic_model_input.schema.json",
  "title": "P-PROJECT-DEFINITION-CRITIC 模型输入契约",
  "description": "执行器 build_project_definition_critic_model_input 生成的模型输入；候选条目/关系改用局部编号（K../L..），模型只做语义审查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "proposal_contract_candidate",
    "argument_graph_candidate",
    "scheme_summary",
    "relation_matrix_allowed",
    "deterministic_findings",
    "human_resolutions",
    "evidence_cards"
  ],
  "properties": {
    "document_type": {"type": "string", "enum": ["RESEARCH_PROPOSAL", "ENGINEERING_PROPOSAL", "SURVEY_REPORT"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_name", "items", "relations"],
      "properties": {
        "project_name": {
          "type": ["string", "null"]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["local_key", "item_type", "domain", "summary", "content"],
            "properties": {
              "local_key": {
                "type": "string",
                "pattern": "^K[0-9]+$"
              },
              "item_type": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "object",
                "description": "候选条目的业务字段原文。",
                "additionalProperties": true
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["local_id", "from_key", "to_key", "relation_type"],
            "properties": {
              "local_id": {
                "type": "string",
                "pattern": "^L[0-9]+$"
              },
              "from_key": {
                "type": "string",
                "pattern": "^K[0-9]+$"
              },
              "to_key": {
                "type": "string",
                "pattern": "^K[0-9]+$"
              },
              "relation_type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "proposal_contract_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "primary_evaluation_logic",
        "max_main_pages",
        "max_core_research_questions",
        "mandatory_sections",
        "status"
      ],
      "properties": {
        "document_type": {
          "type": "string",
          "minLength": 1
        },
        "primary_evaluation_logic": {
          "type": "string",
          "minLength": 1
        },
        "max_main_pages": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "max_core_research_questions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "mandatory_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "argument_graph_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["central_proposition", "research_questions", "in_scope", "out_of_scope"],
      "properties": {
        "central_proposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement", "proposition_type"],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "proposition_type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "research_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "question_type", "gap_keys"],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "question_type": {
                "type": "string",
                "minLength": 1
              },
              "gap_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^K[0-9]+$"
                }
              }
            }
          }
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scheme_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme_name", "scheme_type", "guide_direction_name", "rules"],
      "properties": {
        "scheme_name": {
          "type": ["string", "null"]
        },
        "scheme_type": {
          "type": ["string", "null"]
        },
        "guide_direction_name": {
          "type": ["string", "null"]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_type", "statement", "mandatory"],
            "properties": {
              "rule_type": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "mandatory": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "relation_matrix_allowed": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 3
      }
    },
    "deterministic_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer_text", "target"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer_text": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "document_title", "locator", "excerpt"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "document_title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
