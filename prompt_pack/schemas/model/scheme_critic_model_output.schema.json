{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheme_critic_model_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "REVISE",
        "BLOCK"
      ]
    },
    "checked_local_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R[0-9]+$"
      },
      "uniqueItems": true
    },
    "missing_rule_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          }
        },
        "required": [
          "statement",
          "evidence_id"
        ]
      }
    },
    "numeric_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "local_id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },
          "value_correct": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "local_id",
          "value_correct",
          "note"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "target_local_id": {
            "type": ["string", "null"],
            "pattern": "^R[0-9]+$"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            },
            "uniqueItems": true
          },
          "blocking": {
            "type": "boolean"
          },
          "route": {
            "type": "string",
            "enum": [
              "ORIGINAL_PRODUCER",
              "PROJECT_KNOWLEDGE_AGENT",
              "USER",
              "BLOCK"
            ]
          },
          "repair_instruction": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "code",
          "severity",
          "description",
          "target_local_id",
          "evidence_ids",
          "blocking",
          "route",
          "repair_instruction"
        ]
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "MISSING",
              "CONFLICT",
              "UNCERTAIN",
              "UNSUPPORTED",
              "OUT_OF_SCOPE"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "description",
          "required_action",
          "blocking"
        ]
      }
    },
    "user_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_type": {
            "type": "string",
            "enum": [
              "CONFIRMATION",
              "MISSING_INFORMATION",
              "CONFLICT_RESOLUTION",
              "CHOICE"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "answer_shape": {
            "type": "string",
            "enum": [
              "STRING",
              "NUMBER",
              "BOOLEAN"
            ]
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "blocking": {
            "type": "boolean"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        },
        "required": [
          "question_type",
          "question",
          "reason",
          "answer_shape",
          "allowed_values",
          "blocking",
          "priority"
        ]
      }
    }
  },
  "required": [
    "verdict",
    "checked_local_ids",
    "missing_rule_candidates",
    "numeric_checks",
    "findings",
    "unresolved_items",
    "user_questions"
  ]
}
