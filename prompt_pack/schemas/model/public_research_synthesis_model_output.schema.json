{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public_research_synthesis_model_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "qualifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "claim_text",
          "source_ids",
          "qualifiers"
        ]
      }
    },
    "source_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "agreement": {
            "type": "string",
            "enum": [
              "AGREE",
              "PARTIAL",
              "CONFLICT"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "topic",
          "source_ids",
          "agreement",
          "summary"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "coverage_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "claims",
    "source_comparisons",
    "conflicts",
    "limitations",
    "coverage_summary"
  ]
}
