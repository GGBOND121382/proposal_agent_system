{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public_research_plan_scope_critic_model_input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approved_boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_description": {
          "type": "string",
          "minLength": 1
        },
        "allowed_topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_inferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "task_description",
        "allowed_topics",
        "allowed_context",
        "prohibited_inferences",
        "prohibited_outputs"
      ]
    },
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executable_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query_index": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "linked_question_indexes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "query_index",
          "query",
          "linked_question_indexes"
        ]
      }
    }
  },
  "required": [
    "approved_boundary",
    "research_questions",
    "executable_queries"
  ]
}