{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expression_critic_output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": "2.0"},
    "prompt_id": {"const": "P-EXPRESSION-CRITIC"},
    "prompt_version": {"const": "3.4.0"},
    "status": {
      "type": "string",
      "enum": ["PASS", "REVISE", "NEED_USER_INPUT", "BLOCK"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["ACCEPT", "REVISE", "BLOCK"]
        },
        "checked_paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "expression_assessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "MEANING_PRESERVATION": {"type": "boolean"},
                "TRACE_PRESERVATION": {"type": "boolean"},
                "ACADEMIC_TONE": {"type": "boolean"},
                "SENTENCE_CLARITY": {"type": "boolean"},
                "TRANSITION_LOGIC": {"type": "boolean"},
                "REDUNDANCY": {"type": "boolean"},
                "TERMINOLOGY": {"type": "boolean"},
                "DOCUMENT_TYPE_FIT": {"type": "boolean"}
              },
              "required": [
                "MEANING_PRESERVATION",
                "TRACE_PRESERVATION",
                "ACADEMIC_TONE",
                "SENTENCE_CLARITY",
                "TRANSITION_LOGIC",
                "REDUNDANCY",
                "TERMINOLOGY",
                "DOCUMENT_TYPE_FIT"
              ]
            },
            "affected_paragraph_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "evidence_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": ["checks", "affected_paragraph_ids", "evidence_summary"]
        }
      },
      "required": ["verdict", "checked_paragraph_ids", "expression_assessment"]
    },
    "findings": {"type": "array", "items": {"$ref": "../common/finding.schema.json"}},
    "unresolved_items": {"type": "array", "items": {"$ref": "../common/unresolved_item.schema.json"}},
    "user_questions": {"type": "array", "items": {"$ref": "../common/user_question.schema.json"}},
    "source_refs": {"type": "array", "items": {"$ref": "../common/source_ref.schema.json"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_version",
    "status",
    "result",
    "findings",
    "unresolved_items",
    "user_questions",
    "source_refs",
    "warnings"
  ]
}
