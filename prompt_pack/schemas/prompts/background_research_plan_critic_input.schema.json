{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background_research_plan_critic_input.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "prompt_id": {
      "const": "P-BACKGROUND-RESEARCH-PLAN-CRITIC"
    },
    "prompt_version": {
      "const": "1.0.0"
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workflow_type": {
          "type": "string",
          "enum": [
            "PROJECT_INTAKE",
            "TEMPLATE_EXTRACTION",
            "HYBRID_ONLINE_ASSIST",
            "TOPIC_BACKGROUND_RESEARCH",
            "PROPOSAL_AUTHORING",
            "SECURITY_REVIEW_AND_EXPORT"
          ]
        },
        "current_step": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "writing_mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "COPY_EDIT_ONLY",
                "SUBSTANTIVE_REVISION",
                "DRAFT_FROM_PROJECT_DEFINITION"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "workflow_type",
        "current_step",
        "attempt",
        "writing_mode"
      ]
    },
    "security_context": {
      "$ref": "../common/security_context.schema.json"
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "target_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "read_only_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "protected_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "target_object_ids",
        "read_only_object_ids",
        "protected_object_ids"
      ]
    },
    "freshness": {
      "$ref": "../common/freshness.schema.json"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_boundary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_description": {
              "type": "string",
              "minLength": 1
            },
            "topic_description": {
              "type": "string",
              "minLength": 1
            },
            "allowed_topics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowed_context": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "prohibited_inferences": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "prohibited_outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "task_description",
            "topic_description",
            "allowed_topics",
            "allowed_context",
            "prohibited_inferences",
            "prohibited_outputs"
          ]
        },
        "required_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "OBJECT_AND_EVOLUTION",
              "FUNCTION_AND_ARCHITECTURE",
              "WORKFLOW_AND_INTERACTION",
              "TECHNOLOGY_AND_IMPLEMENTATION",
              "EVALUATION_AND_EFFECT",
              "LIMITATIONS_AND_GAPS",
              "APPLICATION_SCENARIO",
              "STAKEHOLDER_AND_PAIN",
              "INDUSTRY_SCALE_AND_TREND",
              "POLICY_STANDARD_AND_PROGRAM",
              "REPRESENTATIVE_CASE",
              "CURRENT_ADOPTION",
              "OPERATIONAL_CONSTRAINT",
              "RESEARCH_SIGNIFICANCE"
            ]
          },
          "uniqueItems": true
        },
        "executable_queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query_id": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "enum": [
                  "OBJECT_AND_EVOLUTION",
                  "FUNCTION_AND_ARCHITECTURE",
                  "WORKFLOW_AND_INTERACTION",
                  "TECHNOLOGY_AND_IMPLEMENTATION",
                  "EVALUATION_AND_EFFECT",
                  "LIMITATIONS_AND_GAPS",
                  "APPLICATION_SCENARIO",
                  "STAKEHOLDER_AND_PAIN",
                  "INDUSTRY_SCALE_AND_TREND",
                  "POLICY_STANDARD_AND_PROGRAM",
                  "REPRESENTATIVE_CASE",
                  "CURRENT_ADOPTION",
                  "OPERATIONAL_CONSTRAINT",
                  "RESEARCH_SIGNIFICANCE"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "entity_groups": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "maxItems": 8
              }
            },
            "required": [
              "query_id",
              "query",
              "dimension",
              "purpose"
            ]
          }
        }
      },
      "required": [
        "approved_boundary",
        "required_dimensions",
        "executable_queries"
      ]
    },
    "expected_output_schema": {
      "const": "schemas/prompts/background_research_plan_critic_output.schema.json"
    },
    "trusted_source_catalog": {
      "type": "array",
      "items": {
        "$ref": "../common/trusted_source_catalog_entry.schema.json"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_version",
    "task",
    "security_context",
    "scope",
    "freshness",
    "payload",
    "expected_output_schema"
  ]
}
