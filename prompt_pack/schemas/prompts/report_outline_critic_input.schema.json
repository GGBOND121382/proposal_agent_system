{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report_outline_critic_input.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "prompt_id": {
      "const": "P-REPORT-OUTLINE-CRITIC"
    },
    "prompt_version": {
      "const": "1.0.0"
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workflow_type": {
          "type": "string",
          "enum": [
            "PROJECT_INTAKE",
            "TEMPLATE_EXTRACTION",
            "HYBRID_ONLINE_ASSIST",
            "TOPIC_BACKGROUND_RESEARCH",
            "PROPOSAL_AUTHORING",
            "SECURITY_REVIEW_AND_EXPORT"
          ]
        },
        "current_step": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "writing_mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "COPY_EDIT_ONLY",
                "SUBSTANTIVE_REVISION",
                "DRAFT_FROM_PROJECT_DEFINITION"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "workflow_type",
        "current_step",
        "attempt",
        "writing_mode"
      ]
    },
    "security_context": {
      "$ref": "../common/security_context.schema.json"
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "target_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "read_only_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "protected_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "target_object_ids",
        "read_only_object_ids",
        "protected_object_ids"
      ]
    },
    "freshness": {
      "$ref": "../common/freshness.schema.json"
    },
    "payload": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "SURVEY_REPORT"
        },
        "outline_candidate": {
          "type": "object",
          "properties": {
            "report_title": {
              "type": "string",
              "minLength": 1
            },
            "audience": {
              "type": "string",
              "minLength": 1
            },
            "overall_gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "report_sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "section_key": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1
                  },
                  "must_answer_questions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "evidence_card_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "planned_exhibits": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "TABLE",
                            "MERMAID_FIGURE"
                          ]
                        },
                        "caption": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_card_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "caption"
                      ]
                    }
                  },
                  "known_gaps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "estimated_share_percent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false,
                "required": [
                  "section_key",
                  "title",
                  "goal",
                  "must_answer_questions",
                  "known_gaps"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "report_title",
            "report_sections"
          ]
        },
        "background_cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "card_id": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "claim_text": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_mode": {
                "type": "string",
                "minLength": 1
              },
              "scope_qualifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "card_id",
              "dimension",
              "claim_text"
            ]
          }
        },
        "survey_research_brief": {
          "type": "object",
          "properties": {
            "must_answer_questions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "materials_cutoff": {
              "type": "string",
              "minLength": 1
            },
            "source_priorities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scope_exclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deliverable_notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "source_catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "source_id"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "document_type",
        "outline_candidate",
        "background_cards"
      ]
    },
    "expected_output_schema": {
      "type": "string",
      "minLength": 1,
      "const": "schemas/prompts/report_outline_critic_output.schema.json"
    },
    "trusted_source_catalog": {
      "type": "array",
      "items": {
        "$ref": "../common/trusted_source_catalog_entry.schema.json"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_version",
    "task",
    "security_context",
    "scope",
    "freshness",
    "payload",
    "expected_output_schema"
  ]
}