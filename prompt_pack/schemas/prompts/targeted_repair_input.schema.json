{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "targeted_repair_input.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "prompt_id": {
      "const": "P-TARGETED-REPAIR"
    },
    "prompt_version": {
      "const": "3.4.0"
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "x-reference-semantic": "NEW_ENTITY_ID"
        },
        "workflow_type": {
          "type": "string",
          "enum": [
            "PROJECT_INTAKE",
            "TEMPLATE_EXTRACTION",
            "HYBRID_ONLINE_ASSIST",
            "PROPOSAL_AUTHORING",
            "SECURITY_REVIEW_AND_EXPORT"
          ]
        },
        "current_step": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "writing_mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "COPY_EDIT_ONLY",
                "SUBSTANTIVE_REVISION",
                "DRAFT_FROM_PROJECT_DEFINITION"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "workflow_type",
        "current_step",
        "attempt",
        "writing_mode"
      ]
    },
    "security_context": {
      "$ref": "../common/security_context.schema.json"
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "target_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "x-reference-semantic": "ENTITY_REF"
        },
        "read_only_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "x-reference-semantic": "ENTITY_REF"
        },
        "protected_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "x-reference-semantic": "ENTITY_REF"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "target_object_ids",
        "read_only_object_ids",
        "protected_object_ids"
      ]
    },
    "freshness": {
      "$ref": "../common/freshness.schema.json"
    },
    "payload": {
      "type": "object",
      "properties": {
        "original_object": {
          "type": "object",
          "properties": {
            "object_type": {
              "type": "string",
              "minLength": 1
            },
            "object_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "x-reference-semantic": "NEW_ENTITY_ID"
            },
            "object_hash": {
              "type": "string",
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "content": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false,
          "required": [
            "object_type",
            "object_id",
            "object_hash",
            "content"
          ]
        },
        "original_producer": {
          "type": "string",
          "enum": [
            "SECURITY_REVIEW_AGENT",
            "PROJECT_KNOWLEDGE_AGENT",
            "TEMPLATE_AGENT",
            "PLANNING_AGENT",
            "WRITING_AGENT",
            "ARGUMENT_ARCHITECTURE_AGENT",
            "EXPRESSION_EDITOR_AGENT"
          ]
        },
        "findings_to_repair": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "../common/finding.schema.json"
              },
              {
                "required": [
                  "finding_instance_id"
                ]
              }
            ]
          },
          "minItems": 1
        },
        "allowed_paths": {
          "description": "RFC 6901 roots authorizing each listed path and all of its descendants. For example /content/paragraphs/2 authorizes /content/paragraphs/2/function. A child path never authorizes its parent or siblings; protected_paths always take precedence.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
          },
          "minItems": 1,
          "x-reference-semantic": "JSON_POINTER"
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
          },
          "x-reference-semantic": "JSON_POINTER"
        },
        "protected_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$",
                "x-reference-semantic": "JSON_POINTER"
              },
              "hash": {
                "type": "string",
                "minLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "hash"
            ]
          }
        },
        "original_input_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/object_ref.schema.json"
          },
          "minItems": 1,
          "x-reference-semantic": "OBJECT_REF"
        },
        "inherited_source_catalog": {
          "type": "array",
          "description": "Read-only semantic entity namespace inherited from the original producer input. These entries authorize references to existing upstream entities but do not authorize changing any additional path.",
          "items": {
            "$ref": "../common/trusted_source_catalog_entry.schema.json"
          },
          "uniqueItems": true
        },
        "human_resolutions": {
          "type": "array",
          "items": {
            "$ref": "../common/human_resolution.schema.json"
          }
        },
        "contract_feedback": {
          "type": "object",
          "properties": {
            "attempt": {
              "type": "integer",
              "minimum": 2,
              "maximum": 6
            },
            "validation_errors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "attempt",
            "validation_errors"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "original_object",
        "original_producer",
        "findings_to_repair",
        "allowed_paths",
        "protected_paths",
        "protected_hashes",
        "original_input_refs",
        "inherited_source_catalog"
      ]
    },
    "expected_output_schema": {
      "type": "string",
      "minLength": 1,
      "const": "schemas/prompts/targeted_repair_output.schema.json"
    },
    "trusted_source_catalog": {
      "type": "array",
      "items": {
        "$ref": "../common/trusted_source_catalog_entry.schema.json"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_version",
    "task",
    "security_context",
    "scope",
    "freshness",
    "payload",
    "expected_output_schema"
  ]
}
