{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_definition_extract_input.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "prompt_id": {
      "const": "P-PROJECT-DEFINITION-EXTRACT"
    },
    "prompt_version": {
      "const": "3.1.1"
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workflow_type": {
          "type": "string",
          "enum": [
            "PROJECT_INTAKE",
            "TEMPLATE_EXTRACTION",
            "HYBRID_ONLINE_ASSIST",
            "PROPOSAL_AUTHORING",
            "SECURITY_REVIEW_AND_EXPORT"
          ]
        },
        "current_step": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "writing_mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "COPY_EDIT_ONLY",
                "SUBSTANTIVE_REVISION",
                "DRAFT_FROM_PROJECT_DEFINITION"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "workflow_type",
        "current_step",
        "attempt",
        "writing_mode"
      ]
    },
    "security_context": {
      "$ref": "../common/security_context.schema.json"
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "target_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "read_only_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "protected_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "target_object_ids",
        "read_only_object_ids",
        "protected_object_ids"
      ]
    },
    "freshness": {
      "$ref": "../common/freshness.schema.json"
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_documents": {
          "type": "array",
          "items": {
            "$ref": "../common/document_context.schema.json"
          },
          "minItems": 1
        },
        "scheme_profile": {
          "$ref": "../inputs/application_scheme_profile.schema.json"
        },
        "existing_project_definition": {
          "anyOf": [
            {
              "$ref": "../inputs/project_definition_package.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "security_constraints": {
          "$ref": "../common/security_context.schema.json"
        },
        "human_resolutions": {
          "type": "array",
          "items": {
            "$ref": "../common/human_resolution.schema.json"
          }
        },
        "revision_findings": {
          "type": "array",
          "items": {
            "$ref": "../common/finding.schema.json"
          },
          "description": "来自上一轮确定性质量校验、需要当前生产者修正的结构化意见；首次运行时为空数组或缺省。"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_documents",
        "scheme_profile",
        "existing_project_definition",
        "extraction_scope",
        "security_constraints"
      ]
    },
    "expected_output_schema": {
      "type": "string",
      "minLength": 1,
      "const": "schemas/prompts/project_definition_extract_output.schema.json"
    },
    "trusted_source_catalog": {
      "type": "array",
      "items": {
        "$ref": "../common/trusted_source_catalog_entry.schema.json"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_version",
    "task",
    "security_context",
    "scope",
    "freshness",
    "payload",
    "expected_output_schema"
  ]
}
