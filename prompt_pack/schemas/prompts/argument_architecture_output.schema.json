{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "argument_architecture_output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "prompt_id": {
      "const": "P-ARGUMENT-ARCHITECTURE"
    },
    "prompt_version": {
      "const": "9.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "REVISE",
        "NEED_USER_INPUT",
        "BLOCK"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argument_architecture": {
          "type": "object",
          "properties": {
            "graph_id": {
              "type": "string",
              "minLength": 1
            },
            "central_proposition": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "proposition_type": {
                  "type": "string",
                  "enum": [
                    "SCIENTIFIC_HYPOTHESIS",
                    "TECHNICAL_PRINCIPLE",
                    "DESIGN_PROPOSITION",
                    "UNKNOWN"
                  ]
                },
                "falsifiable_or_comparable": {
                  "type": "boolean"
                },
                "boundary_conditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "../common/source_ref.schema.json"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "node_id",
                "statement",
                "proposition_type",
                "falsifiable_or_comparable",
                "boundary_conditions",
                "source_refs"
              ]
            },
            "research_questions": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question_type": {
                    "type": "string",
                    "enum": [
                      "SCIENTIFIC",
                      "TECHNICAL",
                      "ENGINEERING"
                    ]
                  },
                  "linked_gap_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "answerability": {
                    "type": "string",
                    "enum": [
                      "TESTABLE",
                      "COMPARABLE",
                      "DESIGN_VERIFIABLE",
                      "UNCLEAR"
                    ]
                  },
                  "success_evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "statement",
                  "question_type",
                  "linked_gap_ids",
                  "answerability",
                  "success_evidence"
                ]
              }
            },
            "scope_boundaries": {
              "type": "object",
              "properties": {
                "in_scope": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "out_of_scope": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "in_scope",
                "out_of_scope"
              ]
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "node_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "CONFIRMED",
                      "SUPPORTED",
                      "PLANNED",
                      "UNKNOWN",
                      "CONFLICTED"
                    ]
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "../common/source_ref.schema.json"
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "node_type",
                  "statement",
                  "status",
                  "source_refs"
                ]
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "edge_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "edge_id",
                  "source_id",
                  "relation",
                  "target_id",
                  "rationale"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "graph_id",
            "central_proposition",
            "research_questions",
            "scope_boundaries",
            "nodes",
            "edges"
          ]
        },
        "research_design_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "research_question_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "gap_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "objective_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "work_package_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "method_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "evaluation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "innovation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "foundation_evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "closest_prior_work_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "falsification_or_comparison_rule": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "research_question_id",
              "gap_ids",
              "objective_ids",
              "work_package_ids",
              "method_ids",
              "evaluation_ids",
              "innovation_ids",
              "foundation_evidence_ids",
              "closest_prior_work_ids",
              "falsification_or_comparison_rule"
            ]
          },
          "maxItems": 4
        },
        "evidence_gap_report": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gap_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "defect_key": {
                "type": "string",
                "minLength": 1
              },
              "defect_family": {
                "type": "string",
                "minLength": 1
              },
              "finding_code": {
                "type": "string",
                "minLength": 1
              },
              "semantic_component": {
                "type": "string",
                "minLength": 1
              },
              "semantic_object_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "semantic_review_unit_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality_dimension": {
                "type": "string",
                "minLength": 1
              },
              "suggested_route": {
                "enum": [
                  "ORIGINAL_PRODUCER",
                  "ARGUMENT_ARCHITECTURE_AGENT",
                  "USER",
                  "BLOCK"
                ]
              },
              "thread_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "required_node_type": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "suggested_source_or_question": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "gap_id",
              "defect_key",
              "defect_family",
              "finding_code",
              "semantic_component",
              "semantic_object_id",
              "semantic_review_unit_key",
              "quality_dimension",
              "required_node_type",
              "thread_index",
              "reason",
              "blocking",
              "suggested_source_or_question",
              "suggested_route"
            ]
          }
        },
        "scope_decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "main_body_focus": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "appendix_topics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excluded_topics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "main_body_focus",
            "appendix_topics",
            "excluded_topics"
          ]
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "blocking_node_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ready",
            "blocking_node_ids",
            "summary"
          ]
        },
        "authored_evidence_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "node_id",
              "evidence_ids"
            ]
          }
        },
        "authored_thread_assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "thread_index": {
                "type": "integer",
                "minimum": 0
              },
              "assumption_node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "thread_index",
              "assumption_node_ids"
            ]
          }
        },
        "authored_state": {
          "$ref": "../model/argument_architecture_model_output.schema.json"
        },
        "projection_meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projection_version": {
              "type": "string",
              "const": "ARGUMENT_PROJECTOR_V2"
            },
            "source_state_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "projection_input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "projection_version",
            "source_state_sha256",
            "projection_input_sha256"
          ]
        }
      },
      "required": [
        "argument_architecture",
        "research_design_matrix",
        "evidence_gap_report",
        "scope_decision",
        "readiness",
        "authored_evidence_bindings",
        "authored_thread_assumptions",
        "authored_state",
        "projection_meta"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "../common/finding.schema.json"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "../common/unresolved_item.schema.json"
      }
    },
    "user_questions": {
      "type": "array",
      "items": {
        "$ref": "../common/user_question.schema.json"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../common/source_ref.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_version",
    "status",
    "result",
    "findings",
    "unresolved_items",
    "user_questions",
    "source_refs",
    "warnings"
  ],
  "allOf": [
    {
      "$comment": "Semantic contract: incomplete/unknown structure may be emitted only on non-PASS paths.",
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "research_design_matrix": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "gap_ids": {
                      "minItems": 1
                    },
                    "objective_ids": {
                      "minItems": 1
                    },
                    "work_package_ids": {
                      "minItems": 1
                    },
                    "method_ids": {
                      "minItems": 1
                    },
                    "evaluation_ids": {
                      "minItems": 1
                    },
                    "innovation_ids": {
                      "minItems": 1
                    },
                    "closest_prior_work_ids": {
                      "minItems": 1
                    }
                  }
                }
              },
              "scope_decision": {
                "properties": {
                  "main_body_focus": {
                    "minItems": 1
                  }
                }
              },
              "argument_architecture": {
                "properties": {
                  "research_questions": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
