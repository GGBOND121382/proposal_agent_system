{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background_research_critic_output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "prompt_id": {
      "const": "P-BACKGROUND-RESEARCH-CRITIC"
    },
    "prompt_version": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "REVISE",
        "NEED_USER_INPUT",
        "BLOCK"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "ACCEPT_FOR_IMPORT_REVIEW",
            "REVISE",
            "BLOCK"
          ]
        },
        "unsupported_card_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "missing_counterevidence_topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncovered_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "APPLICATION_SCENARIO",
              "STAKEHOLDER_AND_PAIN",
              "INDUSTRY_SCALE_AND_TREND",
              "POLICY_STANDARD_AND_PROGRAM",
              "REPRESENTATIVE_CASE",
              "CURRENT_ADOPTION",
              "OPERATIONAL_CONSTRAINT",
              "RESEARCH_SIGNIFICANCE"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "verdict",
        "unsupported_card_ids",
        "missing_counterevidence_topics",
        "uncovered_dimensions"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "../common/finding.schema.json"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "../common/unresolved_item.schema.json"
      }
    },
    "user_questions": {
      "type": "array",
      "items": {
        "$ref": "../common/user_question.schema.json"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../common/source_ref.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_version",
    "status",
    "result",
    "findings",
    "unresolved_items",
    "user_questions",
    "source_refs",
    "warnings"
  ]
}
