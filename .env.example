APP_HOST=0.0.0.0
APP_PORT=8080
APP_WORKERS=1
APP_RELOAD=false
APP_DATA_DIR=./data
PROMPT_PACK_DIR=./prompt_pack
MODEL_RUNTIME_MODE=REPLAY
DENY_LIVE_CALLS_IN_CI=true

# Track-A capability acceptance and durable model-call evidence.
# Formal capability runs must set MODEL_RUNTIME_MODE=LIVE and CAPABILITY_ACCEPTANCE_MODE=true.
CAPABILITY_ACCEPTANCE_MODE=false
MODEL_CALL_EVIDENCE_DIR=./data/model_calls
RUNTIME_EXPORT_EVIDENCE_DIR=./data/runtime_exports
MODEL_RESPONSE_AUTOMATION=false
SAMPLE_SECTION_FALLBACK=false
AUTO_RESPONSE_ENABLED=false
# Comma-separated one-shot points; leave empty outside fault-injection tests.
RUNTIME_FAULT_POINT=
RUNTIME_FAULT_ACTION=raise
RUNTIME_FAULT_CALL_KEY=
RUNTIME_FAULT_PROMPT_ID=
RUNTIME_FAULT_EXIT_CODE=97

OFFLINE_LLM_ENABLED=true
OFFLINE_LLM_BASE_URL=http://127.0.0.1:8000/v1
OFFLINE_LLM_API_KEY=CHANGE_ME
OFFLINE_GENERAL_MODEL=CHANGE_ME
OFFLINE_CRITIC_MODEL=CHANGE_ME

ONLINE_LLM_ENABLED=false
ONLINE_LLM_BASE_URL=
ONLINE_LLM_API_KEY=
ONLINE_PUBLIC_MODEL=

PUBLIC_SEARCH_PROVIDER=disabled
PUBLIC_SEARCH_BASE_URL=
# recorded: use a verified, archived public-source set without live network access.
# connector: archive raw responses returned by an approved search connector.
# searxng: run live generic web search and archive fetched sources.
# academic: discover scholarly work via OpenAlex + Crossref (Semantic Scholar is disabled by default).
# hybrid: combine academic discovery with SearXNG and an optional browser fallback.
# browser_search (browser alias): use a real public search-engine result page through Playwright.
# Optional scholarly API identity: OPENALEX_MAILTO, CROSSREF_MAILTO.
# Semantic Scholar remains an opt-in adapter for future search-strategy work; it is not used by default.
# If explicitly enabled by code/adapter, SEMANTIC_SCHOLAR_API_KEY and the rate-limit settings below apply.
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.05
SEMANTIC_SCHOLAR_MAX_RETRIES=3
SEMANTIC_SCHOLAR_MAX_RETRY_AFTER_SECONDS=60
PUBLIC_RESEARCH_RECORD_FILE=
PUBLIC_RESEARCH_CONNECTOR_FILE=
PUBLIC_SEARCH_MAX_RESULTS=40
# Candidate pool per approved query before deterministic screening (3..25).
PUBLIC_SEARCH_CANDIDATES_PER_QUERY=8
# Strict WF-3 related-work profile minimum archived sources per approved query (1..8).
PUBLIC_RESEARCH_MIN_SOURCES_PER_QUERY=3
# Phase 3 retrieval execution contract defaults. Empty channel/provider lists derive
# from PUBLIC_SEARCH_PROVIDER; per-task workflow options may override them.
PUBLIC_SEARCH_REQUIRED_CHANNELS=
PUBLIC_SEARCH_REQUIRED_PROVIDERS=
PUBLIC_SEARCH_REQUIRE_WEB_DISCOVERY=false
PUBLIC_RESEARCH_MIN_FULLTEXT_SOURCES_PER_QUERY=1
PUBLIC_SEARCH_ALLOW_SNIPPET_ONLY=true
RESEARCH_FETCH_TIMEOUT_SECONDS=45
RESEARCH_MAX_SOURCE_BYTES=10485760
# Controlled browser search and dynamic-page fetch fallback.
BROWSER_SEARCH_ENABLED=true
BROWSER_SEARCH_URL_TEMPLATE=https://search.brave.com/search?q={query}&source=web
# Optional; Windows normally auto-detects Edge. Linux example: /usr/bin/chromium.
BROWSER_EXECUTABLE=
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_SECONDS=45
BROWSER_RATE_LIMIT_SECONDS=1.5
BROWSER_CACHE_TTL_SECONDS=86400
BROWSER_FETCH_FALLBACK_ENABLED=true
# WF-3 quality-observation bundles are always written to:
# ${APP_DATA_DIR}/wf3_validation/<workflow_id>/<research_session_id>/

# Mermaid rendering. The JavaScript runtime is bundled in third_party/mermaid.
MERMAID_JS_PATH=./third_party/mermaid/mermaid.min.js
# Optional. Linux examples: /usr/bin/chromium; Windows usually auto-detects Edge.
MERMAID_BROWSER_EXECUTABLE=
SKILL_TIMEOUT_SECONDS=60
MODEL_REQUEST_TIMEOUT_SECONDS=240
MAX_UPLOAD_MB=50

# 强制结构化申请书质量门（生产环境必须保持true）
PROPOSAL_QUALITY_GUARD_ENABLED=true

# Runtime dependency preflight and final export tooling.
DEPENDENCY_PROBE_TIMEOUT_SECONDS=10
ALLOW_RUNTIME_FAULT_INJECTION=false
# Optional explicit executables/Chinese fonts. Auto-discovery is attempted first.
LIBREOFFICE_EXECUTABLE=
STAGE8_FONT_SANS_PATH=
STAGE8_FONT_SERIF_PATH=

# WF-3 Safe Online Package runtime TTL (1-30 days).
WF3_SAFE_PACKAGE_TTL_DAYS=7
